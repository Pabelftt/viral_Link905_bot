<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="<%= csrfToken %>"><title><%= title %> · <%= appName %></title><link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css"><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/admin.css"><script defer src="/js/app.js"></script></head>
<body class="admin-body"><main class="admin-login-wrap"><form class="card admin-login" method="post" action="/admin/login"><span class="brand-mark"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span><p class="eyebrow">SECURE ADMIN AREA</p><h1>Welcome back</h1><p class="muted">Sign in to manage Arohi Mim Viral Link.</p><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (error) { %><div class="notice notice-danger" role="alert"><%= error %></div><% } %><label>Admin username<input type="text" name="username" autocomplete="username" required maxlength="100"></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="200"></label><button class="button button-primary full-width" type="submit"><i class="fa-solid fa-lock" aria-hidden="true"></i> Sign in</button><a class="muted small back-home" href="/">Back to app</a></form></main></body></html>
