<%- include('layout-head', { title, csrfToken }) %>
<div class="admin-layout"><%- include('sidebar', { currentPath }) %><main class="admin-main">
  <header class="admin-topbar"><div><p class="eyebrow">MANAGEMENT</p><h1><%= title %></h1></div><span class="admin-user"><i class="fa-solid fa-user-shield" aria-hidden="true"></i> <%= adminUsername %></span></header>
  <% if (section === 'users') { %>
    <section class="card admin-panel"><form class="admin-search" method="get" action="/admin/users"><label class="search-bar"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input name="q" value="<%= search %>" placeholder="Name, username or Telegram ID"><button class="button button-small button-dark">Search</button></label><select name="status" aria-label="Filter users"><option value="" <%= status === '' ? 'selected' : '' %>>All users</option><option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option><option value="suspended" <%= status === 'suspended' ? 'selected' : '' %>>Suspended</option></select></form>
      <div class="table-wrap"><table><thead><tr><th><input type="checkbox" data-select-all aria-label="Select all users"></th><th>User</th><th>Telegram ID</th><th>Balance</th><th>Referrals</th><th>Status</th><th>Admin actions</th></tr></thead><tbody>
      <% items.forEach((item) => { %><tr><td><input type="checkbox" class="row-select" aria-label="Select <%= item.firstName %>"></td><td><strong><%= item.firstName %> <%= item.lastName %></strong><small>@<%= item.username || 'no username' %></small><a class="small text-link" href="/admin/users/<%= item._id %>">Details</a></td><td><%= item.telegramId %></td><td>৳<%= Number(item.balance).toFixed(2) %></td><td><%= item.referralCount %></td><td><span class="status-pill <%= item.isSuspended ? 'danger' : 'success' %>"><%= item.isSuspended ? 'Suspended' : 'Active' %></span></td><td><div class="row-admin-actions"><form method="post" action="/admin/users/<%= item._id %>/balance" class="inline-admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="amount" type="number" step="0.01" placeholder="+/- ৳" required aria-label="Balance adjustment"><input name="reason" type="hidden" value="Admin adjustment"><button class="icon-button" aria-label="Adjust balance"><i class="fa-solid fa-coins" aria-hidden="true"></i></button></form><form method="post" action="/admin/users/<%= item._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isSuspended" value="<%= !item.isSuspended %>"><button class="icon-button" aria-label="<%= item.isSuspended ? 'Unsuspend' : 'Suspend' %> user"><i class="fa-solid <%= item.isSuspended ? 'fa-lock-open' : 'fa-user-lock' %>" aria-hidden="true"></i></button></form></div></td></tr><% }) %>
      </tbody></table></div><p class="muted small">Showing up to 100 matching users. Select all applies to visible results.</p>
    </section>
  <% } else if (section === 'contents') { %>
    <section class="card admin-panel"><details class="create-details" open><summary><i class="fa-solid fa-circle-plus" aria-hidden="true"></i> Add viral link</summary><form method="post" action="/admin/contents" class="admin-form-grid" id="create-content-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="catalog-picker wide-field" data-catalog-picker>
        <label for="p9x9-search">Import from p9x9</label>
        <div class="catalog-combobox">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input id="p9x9-search" type="search" placeholder="Search 800+ p9x9 videos by title, category or route" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="p9x9-results" aria-autocomplete="list" data-catalog-search>
          <span class="catalog-spinner" data-catalog-spinner hidden><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i></span>
        </div>
        <div class="catalog-results" id="p9x9-results" role="listbox" aria-label="p9x9 search results" data-catalog-results hidden></div>
        <p class="catalog-status" data-catalog-status aria-live="polite">Loading latest p9x9 content…</p>
        <div class="catalog-preview" data-catalog-preview hidden>
          <div class="catalog-preview-media">
            <img data-catalog-image alt="Selected content preview" hidden>
            <video data-catalog-video controls preload="metadata" playsinline hidden></video>
          </div>
          <div class="catalog-preview-copy">
            <p class="eyebrow">SELECTED CONTENT</p>
            <strong data-catalog-title></strong>
            <small data-catalog-meta></small>
            <small data-catalog-source></small>
          </div>
        </div>
      </div>
      <label>Title<input name="title" required maxlength="180"></label><label>Image URL<input name="imageUrl" type="url"></label><label>Video URL<input name="videoUrl" type="url"></label><label>Publish date<input name="date" type="date"></label><label>Total views<input name="totalViews" type="number" min="0" value="0"></label><label>Task count (fixed)<input name="requiredTaskCount" type="number" min="5" max="5" value="5" readonly></label><label class="check-label"><input name="isActive" type="checkbox" checked> Active</label><label class="check-label"><input name="isTrending" type="checkbox"> Trending</label><button class="button button-primary">Create content</button></form></details>
      <div class="bulk-toolbar"><form method="post" action="/admin/contents/bulk" id="bulk-contents-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><button type="submit" form="bulk-contents-form" class="button button-muted" data-bulk-action="activate">Activate selected</button><button type="submit" form="bulk-contents-form" class="button button-muted" data-bulk-action="trending">Mark trending</button><button type="submit" form="bulk-contents-form" class="button button-danger" data-bulk-action="delete">Delete selected</button><input type="hidden" form="bulk-contents-form" name="action" value=""><div class="table-wrap"><table><thead><tr><th><input type="checkbox" data-select-all aria-label="Select all contents"></th><th>Content</th><th>Views</th><th>Tasks</th><th>Status</th><th>Actions</th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><input type="checkbox" class="row-select" form="bulk-contents-form" name="ids" value="<%= item._id %>" aria-label="Select <%= item.title %>"></td><td><strong><%= item.title %></strong><small><%= new Date(item.date).toLocaleDateString() %></small></td><td><%= item.totalViews.toLocaleString() %></td><td><%= item.requiredTaskCount %></td><td><span class="status-pill <%= item.isActive ? 'success' : '' %>"><%= item.isActive ? 'Active' : 'Inactive' %><%= item.isTrending ? ' · Trending' : '' %></span></td><td><details><summary class="text-link">Edit</summary><form method="post" action="/admin/contents/<%= item._id %>" class="stack-form compact-edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" value="<%= item.title %>" required maxlength="180"></label><label>Image URL<input name="imageUrl" type="url" value="<%= item.imageUrl %>"></label><label>Video URL<input name="videoUrl" type="url" value="<%= item.videoUrl %>"></label><label>Publish date<input name="date" type="date" value="<%= new Date(item.date).toISOString().slice(0, 10) %>"></label><label>Total views<input name="totalViews" type="number" min="0" value="<%= item.totalViews %>"></label><label>Required tasks<input name="requiredTaskCount" type="number" min="0" value="<%= item.requiredTaskCount %>"></label><label>Active<select name="isActive"><option value="true" <%= item.isActive ? 'selected' : '' %>>Yes</option><option value="false" <%= !item.isActive ? 'selected' : '' %>>No</option></select></label><label>Trending<select name="isTrending"><option value="true" <%= item.isTrending ? 'selected' : '' %>>Yes</option><option value="false" <%= !item.isTrending ? 'selected' : '' %>>No</option></select></label><button class="button button-small button-primary">Save</button></form><form method="post" action="/admin/contents/<%= item._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="delete"><button class="icon-button confirm-action" data-confirm="Delete this content?" aria-label="Delete content"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></form></details></td></tr><% }) %></tbody></table></div></div>
    </section>
  <% } else if (section === 'tasks') { %>
    <section class="card admin-panel"><details class="create-details"><summary><i class="fa-solid fa-circle-plus" aria-hidden="true"></i> Add a task</summary><form method="post" action="/admin/tasks" class="admin-form-grid" id="task-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" required maxlength="180"></label><label>Category<select name="type"><option value="partner">Partner task</option><option value="verification">Verification task</option><option value="daily-video">Daily video task</option><option value="content-unlock">Content unlock task</option></select></label><label>Reward<input name="reward" type="number" min="0" step="0.01" required></label><label>Task link<input name="taskLink" type="url"></label><label>Verification code<input name="verificationCode" maxlength="100"></label><label>Logo / image URL<input name="imageUrl" type="url"></label><label>Daily limit (0 = global default)<input name="dailyLimit" type="number" min="0" value="0"></label><fieldset class="content-assignment"><legend>Apply task to</legend><label><input type="radio" name="applyMode" value="all" checked> All contents</label><label><input type="radio" name="applyMode" value="selected"> Selected contents only</label><div class="content-picker" hidden><label>Search contents<input type="search" data-content-search placeholder="Filter content list"></label><button type="button" class="button button-muted" data-content-select-all>Select all</button><div class="content-picker-list"><% contents.forEach((content) => { %><label class="content-picker-option"><input type="checkbox" name="selectedContentIds" value="<%= content._id %>"> <%= content.title %></label><% }) %></div><small data-selection-count>0 selected</small></div></fieldset><label class="check-label"><input name="isActive" type="checkbox" checked> Active</label><button class="button button-primary">Create task</button></form></details>
      <h2 class="admin-subtitle">Tasks</h2><div class="table-wrap"><table><thead><tr><th>Task</th><th>Category</th><th>Reward</th><th>Applies to</th><th>Status</th><th>Actions</th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><strong><%= item.title %></strong><small><%= item.taskLink %></small></td><td><%= item.type %></td><td>৳<%= Number(item.reward).toFixed(2) %></td><td><%= item.appliesToAllContents ? 'All contents' : item.selectedContentIds.length + ' selected' %></td><td><span class="status-pill <%= item.isActive ? 'success' : '' %>"><%= item.isActive ? 'Active' : 'Inactive' %></span></td><td><details><summary class="text-link">Edit</summary><form method="post" action="/admin/tasks/<%= item._id %>" class="stack-form compact-edit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" value="<%= item.title %>" required maxlength="180"></label><label>Category<select name="type"><% [['partner','Partner task'],['verification','Verification task'],['daily-video','Daily video task'],['content-unlock','Content unlock task']].forEach(([value,label]) => { %><option value="<%= value %>" <%= item.type === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label><label>Reward<input name="reward" type="number" min="0" step="0.01" value="<%= item.reward %>" required></label><label>Task link<input name="taskLink" type="url" value="<%= item.taskLink %>"></label><label>Verification code<input name="verificationCode" value="<%= item.verificationCode %>" maxlength="100"></label><label>Image URL<input name="imageUrl" type="url" value="<%= item.imageUrl %>"></label><label>Daily limit<input name="dailyLimit" type="number" min="0" value="<%= item.dailyLimit %>"></label><label>Active<select name="isActive"><option value="true" <%= item.isActive ? 'selected' : '' %>>Yes</option><option value="false" <%= !item.isActive ? 'selected' : '' %>>No</option></select></label><label>Applies to all contents<select name="appliesToAllContents"><option value="true" <%= item.appliesToAllContents ? 'selected' : '' %>>All contents</option><option value="false" <%= !item.appliesToAllContents ? 'selected' : '' %>>Selected contents</option></select></label><input type="hidden" name="hasSelectedContentIds" value="1"><label>Selected contents<select name="selectedContentIds" multiple><% contents.forEach((content) => { %><option value="<%= content._id %>" <%= item.selectedContentIds.some((selected) => String(selected._id) === String(content._id)) ? 'selected' : '' %>><%= content.title %></option><% }) %></select></label><button class="button button-small button-primary">Save</button></form><form method="post" action="/admin/tasks/<%= item._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="<%= !item.isActive %>"><button class="icon-button" aria-label="Toggle task status"><i class="fa-solid fa-power-off" aria-hidden="true"></i></button><button class="icon-button confirm-action" name="action" value="delete" data-confirm="Delete this task?" aria-label="Delete task"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></form></details></td></tr><% }) %></tbody></table></div>
      <h2 class="admin-subtitle">Pending completion review</h2><% if (pendingCompletions.length) { %><div class="table-wrap"><table><thead><tr><th>User</th><th>Task</th><th>Submitted</th><th>Review</th></tr></thead><tbody><% pendingCompletions.forEach((completion) => { %><tr><td><%= completion.userId?.firstName || 'User' %> · <%= completion.userId?.telegramId || '' %></td><td><%= completion.taskId?.title || 'Task' %> · ৳<%= Number(completion.reward).toFixed(2) %></td><td><%= new Date(completion.updatedAt).toLocaleString() %></td><td><form class="inline-admin-form" method="post" action="/admin/task-completions/<%= completion._id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-primary" name="action" value="approve">Approve</button><button class="button button-small button-danger" name="action" value="reject">Reject</button></form></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No completion requests waiting for review.</p><% } %>
    </section>
  <% } else if (section === 'withdrawals') { %>
    <section class="card admin-panel"><form class="admin-search" method="get"><select name="status" aria-label="Filter by status"><option value="">All statuses</option><% ['pending','approved','rejected'].forEach((value) => { %><option value="<%= value %>" <%= status === value ? 'selected' : '' %>><%= value %></option><% }) %></select><select name="method" aria-label="Filter by payment method"><option value="">All payment methods</option><% ['bKash','Nagad','Rocket'].forEach((value) => { %><option value="<%= value %>" <%= method === value ? 'selected' : '' %>><%= value %></option><% }) %></select><label>From<input type="date" name="dateFrom" value="<%= dateFrom %>"></label><label>To<input type="date" name="dateTo" value="<%= dateTo %>"></label><button class="button button-small button-dark">Filter</button></form><div class="table-wrap"><table><thead><tr><th>User</th><th>Amount</th><th>Payment</th><th>Wallet</th><th>Status</th><th>Request date</th><th>Review</th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><strong><%= item.userId?.firstName || 'User' %></strong><small><%= item.userId?.telegramId || '' %></small></td><td>৳<%= Number(item.amount).toFixed(2) %></td><td><%= item.paymentMethod %></td><td><%= item.walletNumber %></td><td><span class="status-pill <%= item.status === 'approved' ? 'success' : item.status === 'rejected' ? 'danger' : '' %>"><%= item.status %></span></td><td><%= new Date(item.requestedAt).toLocaleString() %></td><td><% if (item.status === 'pending') { %><form method="post" action="/admin/withdrawals/<%= item._id %>" class="withdraw-review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="adminNote" placeholder="Admin note" maxlength="500"><button class="button button-small button-primary" name="action" value="approve">Approve</button><button class="button button-small button-danger" name="action" value="reject">Reject</button></form><% } else { %><small><%= item.adminNote %></small><% } %></td></tr><% }) %></tbody></table></div></section>
  <% } else if (section === 'broadcasts') { %>
    <section class="card admin-panel"><details class="create-details" open><summary><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Create broadcast</summary><form method="post" action="/admin/broadcasts" id="broadcast-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="recipientMode" value="manual" data-recipient-mode><div class="admin-form-grid"><label>Template<select name="template" data-broadcast-template><option value="custom">Custom Message</option><option value="welcome">Welcome Message</option><option value="viral">New Viral Link Alert</option><option value="task">New Task Alert</option><option value="withdrawal">Withdrawal Update</option><option value="referral">Referral Bonus Alert</option><option value="offer">Promotional Offer</option><option value="maintenance">Maintenance Notice</option></select></label><label>Message title<input name="title" required maxlength="180"></label><label class="wide-field">Message body<textarea name="body" required maxlength="4000" rows="4"></textarea></label><label>Image URL (optional)<input name="imageUrl" type="url"></label><label>Button text<input name="buttonText" maxlength="60"></label><label>Button URL<input name="buttonUrl" type="url"></label><label>Related viral link<select name="relatedContentId" data-related-content><option value="">None</option><% contents.forEach((content) => { %><option value="<%= content._id %>"><%= content.title %></option><% }) %></select></label><label>Related task<select name="relatedTaskId" data-related-task><option value="">None</option><% tasks.forEach((task) => { %><option value="<%= task._id %>"><%= task.title %></option><% }) %></select></label></div><section class="message-preview"><p class="eyebrow">MESSAGE PREVIEW</p><strong data-preview-title>Broadcast title</strong><p data-preview-body>Your message will be shown here.</p><span data-preview-button hidden></span></section><div class="broadcast-recipients"><h3>Recipients <span class="small muted" data-recipient-count>0 selected</span></h3><div class="admin-search"><input type="search" name="recipientSearch" data-user-search placeholder="Search recipients"><select name="recipientFilter" data-user-filter aria-label="Filter recipients"><option value="all">All users</option><option value="active">Active users</option><option value="balance">Users with balance</option><option value="pending">Users with pending withdrawals</option><option value="referrals">Users with referrals</option><option value="non-suspended">Non-suspended users</option></select><button type="button" class="button button-small button-muted" data-recipient-select>Select all matching filter</button></div><div class="recipient-list"><% users.forEach((item) => { %><label class="recipient-row" data-recipient data-name="<%= (item.firstName + ' ' + item.username + ' ' + item.telegramId).toLowerCase() %>" data-balance="<%= item.balance > 0 %>" data-active="<%= item.lastActiveAt > new Date(Date.now() - 30 * 86400000) %>" data-pending="<%= pendingSet.has(String(item._id)) %>" data-referrals="<%= referralSet.has(String(item._id)) %>" data-suspended="<%= item.isSuspended %>"><input type="checkbox" name="recipientIds" value="<%= item._id %>" <%= item.isSuspended ? 'disabled' : '' %>><span><strong><%= item.firstName %> <small>@<%= item.username || 'no username' %></small></strong><small><%= item.telegramId %> · ৳<%= item.balance.toFixed(2) %></small></span><span class="status-pill <%= item.isSuspended ? 'danger' : 'success' %>"><%= item.isSuspended ? 'Suspended' : 'Active' %></span></label><% }) %></div><div data-excluded-list></div><p class="muted small">Select recipients and preview your message. Telegram sends are queued and delivery results are logged.</p></div><button class="button button-primary" type="submit"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Send broadcast</button></form></details>
      <h2 class="admin-subtitle">Broadcast history</h2><div class="table-wrap"><table><thead><tr><th>Message</th><th>Related item</th><th>Status</th><th>Pending</th><th>Sent</th><th>Failed</th><th>Created</th><th>Actions</th></tr></thead><tbody><% items.forEach((item) => { %><tr><td><strong><%= item.title %></strong><small><%= item.body %></small></td><td><%= item.relatedContentId?.title || item.relatedTaskId?.title || '—' %></td><td><span class="status-pill"><%= item.status %></span></td><td><%= item.pendingCount %></td><td><%= item.sentCount %></td><td><%= item.failedCount %></td><td><%= new Date(item.createdAt).toLocaleString() %></td><td><% if (['queued','completed','failed'].includes(item.status)) { %><form method="post" action="/admin/broadcasts/<%= item._id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button confirm-action" data-confirm="Delete this broadcast and its delivery history?" aria-label="Delete broadcast"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></form><% } else { %><span class="muted small">Sending</span><% } %></td></tr><% }) %></tbody></table></div></section>
  <% } else if (section === 'settings') { %>
    <section class="card admin-panel"><h2>Promotional banner</h2><p class="muted">Text shown on the Mini App home page.</p><form method="post" action="/admin/settings" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Banner message<textarea name="banner" maxlength="500" rows="3"><%= banner %></textarea></label><button class="button button-primary">Save banner</button></form></section>
  <% } %>
</main></div>
<%- include('layout-foot') %>
