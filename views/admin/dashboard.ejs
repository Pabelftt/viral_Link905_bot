<%- include('layout-head', { title, csrfToken }) %>
<div class="admin-layout">
  <%- include('sidebar', { currentPath }) %>
  <main class="admin-main">
    <header class="admin-topbar"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1></div><span class="admin-user"><i class="fa-solid fa-user-shield" aria-hidden="true"></i> <%= adminUsername %></span></header>
    <section class="admin-stat-grid">
      <% const cards = [['Total users', stats.totalUsers, 'fa-users', 'purple'], ['Active users · 30d', stats.activeUsers, 'fa-user-check', 'green'], ['Suspended users', stats.suspendedUsers, 'fa-user-lock', 'orange'], ['Viral links', stats.totalContents, 'fa-video', 'blue'], ['Tasks completed', stats.totalCompletions, 'fa-list-check', 'purple'], ['Rewards issued', '৳' + Number(stats.rewardTotal).toFixed(2), 'fa-coins', 'green'], ['Pending payouts', stats.pendingWithdrawals, 'fa-hourglass-half', 'orange'], ['Approved payouts', stats.approvedWithdrawals, 'fa-circle-check', 'green'], ['Total referrals', stats.totalReferrals, 'fa-user-plus', 'blue']]; cards.forEach((card) => { %><article class="card admin-stat"><span class="stat-icon <%= card[3] %>"><i class="fa-solid <%= card[2] %>" aria-hidden="true"></i></span><div><small><%= card[0] %></small><strong><%= card[1] %></strong></div></article><% }) %>
    </section>
    <div class="admin-two-col"><section class="card admin-panel"><div class="admin-panel-heading"><h2>Recent activity</h2><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i></div><% if (activities.length) { activities.forEach((item) => { %><div class="admin-list-row"><span class="activity-dot"></span><div><strong><%= item.action.replaceAll('_', ' ') %></strong><small><%= item.actorId?.firstName || item.actorType %> · <%= new Date(item.createdAt).toLocaleString() %></small></div><% if (item.amount !== null) { %><b>৳<%= Number(item.amount).toFixed(2) %></b><% } %></div><% }) } else { %><p class="muted">No activity recorded yet.</p><% } %></section>
    <section class="card admin-panel"><div class="admin-panel-heading"><h2>Recent withdrawals</h2><a href="/admin/withdrawals">View all</a></div><% if (recentWithdrawals.length) { recentWithdrawals.forEach((item) => { %><div class="admin-list-row"><span class="withdraw-icon"><i class="fa-solid fa-money-bill-transfer" aria-hidden="true"></i></span><div><strong><%= item.userId?.firstName || 'User' %> · ৳<%= Number(item.amount).toFixed(2) %></strong><small><%= item.paymentMethod %> · <%= item.status %> · <%= new Date(item.requestedAt).toLocaleDateString() %></small></div><% if (item.status === 'pending') { %><a class="text-link" href="/admin/withdrawals?status=pending">Review</a><% } %></div><% }) } else { %><p class="muted">No withdrawal requests yet.</p><% } %></section></div>
  </main>
</div>
<%- include('layout-foot') %>
