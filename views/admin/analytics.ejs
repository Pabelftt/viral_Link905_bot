<%- include('layout-head', { title, csrfToken }) %>
<div class="admin-layout">
  <%- include('sidebar', { currentPath: '/admin/analytics' }) %>
  <main class="admin-main">
    <header class="admin-topbar"><div><p class="eyebrow">TRAFFIC & ENGAGEMENT</p><h1>Analytics</h1></div><span class="admin-user"><i class="fa-solid fa-chart-line" aria-hidden="true"></i> First-party report</span></header>
    <div data-analytics-live-container><%- include('analytics-content', { analytics, formatDuration }) %></div>
    <p class="analytics-live-status" data-analytics-live-status aria-live="polite"><i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i> Connecting to live analytics…</p>
    <p class="analytics-privacy muted">First-party analytics only. Page activity and time spent are retained for 180 days; IP addresses, device fingerprints, and full URLs are not stored. Content is linked internally for reporting; raw identifiers are not displayed.</p>
  </main>
</div>
<%- include('layout-foot') %>
