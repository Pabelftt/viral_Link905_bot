<%- include('layout-head', { title, csrfToken }) %>
<div class="admin-layout"><%- include('sidebar', { currentPath }) %><main class="admin-main">
  <header class="admin-topbar"><div><p class="eyebrow">USER MANAGEMENT</p><h1><%= user.firstName %> <%= user.lastName %></h1></div><a class="button button-muted" href="/admin/users"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Users</a></header>
  <section class="admin-stat-grid">
    <% [['Telegram ID', user.telegramId, 'fa-id-card'], ['Username', user.username ? '@' + user.username : '—', 'fa-at'], ['Balance', '৳' + Number(user.balance).toFixed(2), 'fa-wallet'], ['Reserved', '৳' + Number(user.reservedBalance).toFixed(2), 'fa-lock'], ['Referrals', user.referralCount, 'fa-user-plus'], ['Joined', new Date(user.joinedAt).toLocaleDateString(), 'fa-calendar']].forEach((item) => { %><article class="card admin-stat"><span class="stat-icon purple"><i class="fa-solid <%= item[2] %>" aria-hidden="true"></i></span><div><small><%= item[0] %></small><strong><%= item[1] %></strong></div></article><% }) %>
  </section>
  <section class="card admin-panel user-detail-actions"><h2>Account actions</h2><form method="post" action="/admin/users/<%= user._id %>/balance" class="inline-admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="amount" type="number" step="0.01" placeholder="+/- amount" required><input name="reason" placeholder="Reason" maxlength="200"><button class="button button-small button-primary">Adjust balance</button></form><form method="post" action="/admin/users/<%= user._id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isSuspended" value="<%= !user.isSuspended %>"><button class="button button-small <%= user.isSuspended ? 'button-primary' : 'button-danger' %>"><i class="fa-solid <%= user.isSuspended ? 'fa-lock-open' : 'fa-user-lock' %>" aria-hidden="true"></i> <%= user.isSuspended ? 'Unsuspend' : 'Suspend' %></button></form></section>
  <section class="card admin-panel"><h2>Referral history</h2><% if (referrals.length) { referrals.forEach((item) => { %><div class="admin-list-row"><span class="withdraw-icon"><i class="fa-solid fa-user-plus" aria-hidden="true"></i></span><div><strong><%= item.referrerId?._id.toString() === user._id.toString() ? item.referredUserId?.firstName : item.referrerId?.firstName %></strong><small><%= item.referrerId?._id.toString() === user._id.toString() ? 'Invited by this user' : 'This user was invited by' %> · <%= new Date(item.createdAt).toLocaleString() %></small></div></div><% }) } else { %><p class="muted">No referral records.</p><% } %></section>
  <section class="card admin-panel"><h2>Task history</h2><div class="table-wrap"><table><thead><tr><th>Task</th><th>Status</th><th>Reward</th><th>Updated</th></tr></thead><tbody><% completions.forEach((item) => { %><tr><td><%= item.taskId?.title || 'Removed task' %></td><td><%= item.status %></td><td>৳<%= Number(item.reward || item.taskId?.reward || 0).toFixed(2) %></td><td><%= new Date(item.updatedAt).toLocaleString() %></td></tr><% }) %></tbody></table></div></section>
  <section class="card admin-panel"><h2>Withdrawal history</h2><div class="table-wrap"><table><thead><tr><th>Amount</th><th>Payment</th><th>Wallet</th><th>Status</th><th>Admin note</th><th>Date</th></tr></thead><tbody><% withdrawals.forEach((item) => { %><tr><td>৳<%= Number(item.amount).toFixed(2) %></td><td><%= item.paymentMethod %></td><td><%= item.walletNumber %></td><td><%= item.status %></td><td><%= item.adminNote %></td><td><%= new Date(item.requestedAt).toLocaleString() %></td></tr><% }) %></tbody></table></div></section>
</main></div>
<%- include('layout-foot') %>
