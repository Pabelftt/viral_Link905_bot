<%- include('../partials/user-head', { title, csrfToken }) %>
<%- include('../partials/user-header', { user }) %>
<section class="page-heading"><div><p class="eyebrow">GROW TOGETHER</p><h1>Refer &amp; Earn</h1><p class="muted">Invite friends and unlock bonus rewards.</p></div><span class="heading-art"><i class="fa-solid fa-user-plus"></i></span></section>
<section class="card referral-card"><div class="referral-total"><span class="referral-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></span><div><small>Total referrals</small><strong><%= user.referralCount %></strong></div></div><p class="muted">Share your unique invite link with friends.</p><div class="copy-field"><input readonly value="<%= referralUrl %>" aria-label="Your referral link" id="referral-link"><button class="button button-primary" data-copy="#referral-link" aria-label="Copy referral link"><i class="fa-solid fa-copy" aria-hidden="true"></i> Copy</button></div><% if (referralUrl) { %><a class="button button-telegram" target="_blank" rel="noopener noreferrer" href="https://t.me/share/url?url=<%= encodeURIComponent(referralUrl) %>&text=<%= encodeURIComponent('Join me on Arohi Mim Viral Link!') %>"><i class="fa-brands fa-telegram" aria-hidden="true"></i> Share on Telegram</a><% } %></section>
<section class="content-section"><div class="section-title"><div><h2>Referral milestones</h2><p class="muted">Claim each milestone once</p></div></div><div class="milestone-list"><% milestones.forEach((item, index) => { const claimed = claimedMilestones.includes(item.count); const ready = user.referralCount >= item.count; %><article class="milestone-card"><span class="milestone-icon"><i class="fa-solid fa-trophy" aria-hidden="true"></i></span><div class="milestone-copy"><strong><%= item.count %> Referrals</strong><small>Bonus ৳<%= item.reward %></small><div class="progress-track"><span style="width:<%= Math.min(100, user.referralCount / item.count * 100) %>%"></span></div></div><% if (claimed) { %><span class="status-pill success">Claimed</span><% } else if (ready) { %><button class="button button-small button-primary" data-claim="<%= index %>">Claim</button><% } else { %><span class="status-pill"><i class="fa-solid fa-lock" aria-hidden="true"></i> Locked</span><% } %></article><% }) %></div></section>
<section class="content-section"><div class="section-title"><div><h2>Recent invites</h2><p class="muted">Latest 20 referrals</p></div></div><div class="card referral-list"><% if (referrals.length) { referrals.forEach((referral) => { %><div class="referral-row"><span class="avatar-initial"><%= (referral.referredUserId?.firstName || 'U').slice(0, 1).toUpperCase() %></span><div><strong><%= referral.referredUserId?.firstName || 'Telegram user' %></strong><small><%= referral.referredUserId?.username ? '@' + referral.referredUserId.username : new Date(referral.createdAt).toLocaleDateString() %></small></div><span class="status-pill success">Joined</span></div><% }) } else { %><div class="empty-state compact"><i class="fa-solid fa-user-plus" aria-hidden="true"></i><h3>No invites yet.</h3><p>Your invited friends will show up here.</p></div><% } %></div></section>
<%- include('../partials/user-nav') %>
<%- include('../partials/user-foot') %>
