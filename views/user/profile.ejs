<%- include('../partials/user-head', { title, csrfToken }) %>
<%- include('../partials/user-header', { user }) %>
<section class="page-heading"><div><p class="eyebrow">ACCOUNT</p><h1>Your Profile</h1><p class="muted">Manage your rewards and withdrawals.</p></div></section>
<section class="card profile-card"><div class="profile-identity"><% if (user.photoUrl) { %><img src="<%= user.photoUrl %>" alt="" referrerpolicy="no-referrer"><% } else { %><span class="avatar-large"><%= user.firstName.slice(0, 1).toUpperCase() %></span><% } %><div><h2><%= user.firstName %> <%= user.lastName %></h2><p class="muted"><%= user.username ? '@' + user.username : 'Telegram user' %></p></div></div><div class="profile-stats"><div><small>Telegram ID</small><strong><%= user.telegramId %></strong></div><div><small>Balance</small><strong class="text-success">৳<%= Number(user.balance).toFixed(2) %></strong></div><div><small>Referrals</small><strong><%= user.referralCount %></strong></div></div></section>
<section class="content-section"><div class="section-title"><div><h2>Withdrawal requirements</h2><p class="muted">Complete all requirements before requesting a withdrawal.</p></div></div><div class="card requirement-list"><% const checks = [{ label: 'Referrals', current: requirements.referralCount, required: requirements.referrals }, { label: 'Completed tasks', current: requirements.completedTasks, required: requirements.tasks }, { label: 'Content unlocks', current: requirements.unlockedContents, required: requirements.unlocks }]; checks.forEach((item) => { const ok = item.current >= item.required; %><div class="requirement-row"><span class="requirement-icon <%= ok ? 'complete' : '' %>"><i class="fa-solid <%= ok ? 'fa-check' : 'fa-hourglass-half' %>" aria-hidden="true"></i></span><div><strong><%= item.label %></strong><small><%= item.current %> / <%= item.required %></small></div><span class="status-pill <%= ok ? 'success' : '' %>"><%= ok ? 'Complete' : 'Incomplete' %></span></div><% }) %></div></section>
<section class="content-section"><div class="section-title"><div><h2>Request a withdrawal</h2><p class="muted">Minimum amount: ৳<%= minWithdrawAmount %></p></div></div><form class="card form-card" id="withdraw-form"><label>Payment method<select name="paymentMethod" required <%= requirements.canWithdraw ? '' : 'disabled' %>><option value="">Choose a method</option><option>bKash</option><option>Nagad</option><option>Rocket</option></select></label><label>Wallet / mobile number<input name="walletNumber" type="tel" inputmode="numeric" placeholder="01XXXXXXXXX" required pattern="(?:\\+?88)?01[3-9][0-9]{8}" <%= requirements.canWithdraw ? '' : 'disabled' %>></label><label>Amount (৳)<input name="amount" type="number" min="<%= minWithdrawAmount %>" step="0.01" max="<%= user.balance %>" placeholder="100" required <%= requirements.canWithdraw ? '' : 'disabled' %>></label><button class="button button-primary" type="submit" <%= requirements.canWithdraw ? '' : 'disabled' %>><i class="fa-solid fa-money-bill-transfer" aria-hidden="true"></i> Withdraw Request</button><p class="form-message muted" aria-live="polite"><%= requirements.canWithdraw ? '' : 'Complete the requirements above to unlock withdrawals.' %></p></form></section>
<section class="content-section"><div class="section-title"><div><h2>Withdrawal history</h2><p class="muted">Recent payout requests</p></div></div><div class="card history-list" id="withdrawal-history" data-page="1"><% if (withdrawals.length) { withdrawals.forEach((item) => { %><div class="history-row"><div><strong>৳<%= Number(item.amount).toFixed(2) %></strong><small><%= item.paymentMethod %> · <%= item.walletNumber.slice(0,3) %>••••<%= item.walletNumber.slice(-2) %></small><% if (item.adminNote) { %><small>Note: <%= item.adminNote %></small><% } %></div><span class="status-pill <%= item.status === 'approved' ? 'success' : item.status === 'rejected' ? 'danger' : '' %>"><%= item.status %></span></div><% }) } else { %><div class="empty-state compact"><i class="fa-solid fa-receipt" aria-hidden="true"></i><h3>No withdrawal history</h3><p>Your requests will appear here.</p></div><% } %></div><% if (withdrawals.length === 10) { %><button class="button button-outline load-more" id="withdrawal-load-more">Load more</button><% } %></section>
<%- include('../partials/user-nav') %>
<%- include('../partials/user-foot') %>
