<%- include('../partials/user-head', { title, csrfToken }) %>
<%- include('../partials/user-header', { user }) %>
<section class="page-heading">
  <div><p class="eyebrow">DISCOVER</p><h1>New Viral Link</h1><p class="muted">Watch ads to unlock premium content.</p></div>
  <span class="heading-art" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
</section>
<% if (!user) { %>
  <section class="card welcome-card"><div class="welcome-icon"><i class="fa-brands fa-telegram" aria-hidden="true"></i></div><h2>Welcome to Arohi Mim</h2><p>Open this app from Telegram to securely sign in and start earning.</p><button class="button button-primary" data-telegram-login>Continue with Telegram</button><p class="muted small" data-auth-status></p></section>
<% } %>
<% if (banner) { %><a class="promo-banner" href="/earn"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i><span><%= banner %></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a><% } %>
<section class="content-section">
  <div class="section-title"><div><h2>Trending Links</h2><p class="muted">Fresh picks chosen for you</p></div><a class="text-link" href="/earn">Earn more <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
  <form class="search-bar" id="content-search" role="search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="search-input" type="search" placeholder="Search viral links..." aria-label="Search viral links"><button type="submit">Search</button></form>
  <div class="filter-tabs" role="group" aria-label="Sort links">
    <button class="filter-chip selected" data-sort="latest">Latest</button><button class="filter-chip" data-sort="views">Most Viewed</button><button class="filter-chip" data-sort="trending">Trending</button>
  </div>
  <div class="content-grid" id="content-list">
    <% contents.forEach((content) => { %><article class="content-card">
      <a class="content-image" href="/content/<%= content._id %>"><% if (content.imageUrl) { %><img src="<%= content.imageUrl %>" alt="" loading="lazy"><% } else { %><span class="image-placeholder"><i class="fa-solid fa-video" aria-hidden="true"></i></span><% } %><span class="lock-badge"><i class="fa-solid <%= content.isUnlocked ? 'fa-lock-open' : 'fa-lock' %>" aria-hidden="true"></i> <%= content.isUnlocked ? 'Unlocked' : 'Locked' %></span></a>
      <div class="content-card-body"><div class="content-meta"><span><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= new Date(content.date).toLocaleDateString() %></span><span><i class="fa-solid fa-eye" aria-hidden="true"></i> <%= Number(content.totalViews || 0).toLocaleString() %></span></div>
        <h3><a href="/content/<%= content._id %>"><%= content.title %></a></h3><div class="content-card-footer"><span class="task-count"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Tasks (<%= content.taskProgress?.completed || 0 %>/<%= content.taskProgress?.total ?? content.requiredTaskCount %>)</span><div class="card-actions"><button class="icon-button" data-share="<%= content.title %>" data-url="<%= telegramWebAppUrl %>/content/<%= content._id %>" aria-label="Share <%= content.title %>"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i></button><a class="button button-small button-dark" href="/content/<%= content._id %>">Details</a></div></div>
      </div>
    </article><% }) %>
  </div>
  <% if (!contents.length) { %><div class="empty-state"><i class="fa-solid fa-video" aria-hidden="true"></i><h3>No viral links yet</h3><p>New content will appear here soon.</p></div><% } %>
  <button class="button button-outline load-more" id="load-more" hidden>Load more</button>
</section>
<%- include('../partials/user-nav') %>
<%- include('../partials/user-foot') %>
