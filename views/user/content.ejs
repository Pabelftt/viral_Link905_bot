<%- include('../partials/user-head', { title, csrfToken }) %>
<%- include('../partials/user-header', { user }) %>
<a href="/" class="back-link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to links</a>
<article class="content-detail">
  <div class="detail-cover"><% if (content.imageUrl) { %><img src="<%= content.imageUrl %>" alt="<%= content.title %>"><% } else { %><span class="image-placeholder"><i class="fa-solid fa-video" aria-hidden="true"></i></span><% } %></div>
  <div class="detail-heading"><div><p class="eyebrow">VIRAL CONTENT</p><h1><%= content.title %></h1><div class="content-meta"><span><i class="fa-regular fa-calendar" aria-hidden="true"></i> <%= new Date(content.date).toLocaleDateString() %></span><span><i class="fa-solid fa-eye" aria-hidden="true"></i> <%= content.totalViews.toLocaleString() %> views</span></div></div><button class="icon-button" data-share="<%= content.title %>" data-url="<%= telegramWebAppUrl %>/content/<%= content._id %>" aria-label="Share <%= content.title %>"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i></button></div>
  <section class="content-section"><div class="section-title"><div><h2>Unlock this content</h2><p class="muted">Complete the assigned tasks to continue.</p></div><span class="status-pill <%= allDone ? 'success' : '' %>"><i class="fa-solid <%= allDone ? 'fa-lock-open' : 'fa-lock' %>" aria-hidden="true"></i> <%= allDone ? 'Unlocked' : 'Locked' %></span></div>
    <div class="task-list">
      <% if (tasks.length) { tasks.forEach((task) => { %><article class="task-card" data-task-id="<%= task._id %>" data-content-id="<%= task.type === 'content-unlock' || !task.appliesToAllContents ? content._id : '' %>" data-task-type="<%= task.type %>" <%= task.status === 'started' ? 'data-started="true"' : '' %>><span class="task-logo"><% if (task.imageUrl) { %><img src="<%= task.imageUrl %>" alt=""><% } else { %><i class="fa-solid <%= task.type === 'verification' ? 'fa-shield-halved' : 'fa-bullseye' %>" aria-hidden="true"></i><% } %></span><div class="task-copy"><strong><%= task.title %></strong><small class="text-success">Reward ৳<%= Number(task.reward).toFixed(2) %></small><% if (task.type === 'verification' && !task.completed) { %><label class="inline-code">Verification code<input data-code type="text" maxlength="100" placeholder="Enter code"></label><% } %></div><div class="task-action"><% if (task.completed) { %><span class="status-pill success">Completed</span><% } else if (task.status === 'pending') { %><span class="status-pill">Pending review</span><% } else { %><button class="button button-small button-primary" data-task-action><%= task.status === 'started' ? 'Submit for review' : task.type === 'verification' ? 'Verify' : 'Start Task' %></button><% } %></div></article><% }) } else { %><div class="empty-state"><i class="fa-solid fa-layer-group" aria-hidden="true"></i><h3>No tasks available</h3><p>Check back later for new tasks.</p></div><% } %>
    </div>
  </section>
  <% if (allDone && content.videoUrl) { %><section class="card unlocked-content"><div class="unlock-title"><i class="fa-solid fa-lock-open" aria-hidden="true"></i><h2>Content unlocked</h2></div><% if (embedUrl) { %><iframe src="<%= embedUrl %>" title="<%= content.title %>" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><% } else { %><a class="button button-primary" href="<%= content.videoUrl %>" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-play" aria-hidden="true"></i> Open content</a><% } %></section><% } %>
</article>
<%- include('../partials/user-nav') %>
<%- include('../partials/user-foot') %>
